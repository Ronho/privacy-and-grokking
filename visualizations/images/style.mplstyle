# accessible.mplstyle

axes.prop_cycle: cycler('color', ['0072B2', 'E69F00', '009E73', 'D55E00', 'CC79A7', '56B4E9']) + cycler('linestyle', ['-', '--', ':', '-.', '-', '--'])

font.size: 14
axes.titlesize: 16
axes.labelsize: 14
xtick.labelsize: 12
ytick.labelsize: 12

axes.grid: True
grid.alpha: 0.5
grid.linestyle: --