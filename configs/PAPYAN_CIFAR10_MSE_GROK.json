{
    "model": {
        "name": "resnet",
        "initialization_scale": 8.0
    },
    "seed": 0,
    "batch_size": 128,
    "loss": {
        "name": "mse"
    },
    "scheduler": {
        "name": "MultiStepLR",
        "milestones": [
            45500,
            91000
        ],
        "gamma": 0.1
    },
    "optimizer": {
        "name": "SGD",
        "lr": 0.05,
        "momentum": 0.9,
        "weight_decay": 0.0005
    },
    "metrics": {
        "loss_stats": true,
        "accuracy": true,
        "weight_norms": true,
        "gradient_norms": true,
        "optimizer_internals": true,
        "rnc1": true,
        "nhsic": false,
        "nhsic_max_samples": 2048,
        "distribution_overlap": true,
        "distribution_overlap_adaptive": false,
        "distribution_overlap_kde": false,
        "soft_overlap": true,
        "kl_divergence": false,
        "kl_divergence_adaptive": false,
        "kl_divergence_kde": false,
        "js_distance": false,
        "js_distance_adaptive": false,
        "js_distance_kde": false,
        "mmd": false,
        "attack_true_class_prob": true,
        "attack_true_class_logit": true,
        "attack_ce_loss": true,
        "attack_mse_loss": true,
        "attack_correctness": true,
        "attack_distance_to_class_mean": true,
        "curvature": false,
        "merlin_morgan": false,
        "neural_collapse": true,
        "one_run_audit": false
    },
    "data": {
        "data": {
            "name": "cifar10"
        },
        "mask": {
            "name": "uniform",
            "num_models": 256,
            "p": 0.5,
            "seed": 0,
            "model_index": 0
        },
        "train_size": 1000,
        "seed": 0
    }
}
